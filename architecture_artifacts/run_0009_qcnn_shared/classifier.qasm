OPENQASM 3.0;
include "stdgates.inc";

// Raw feature inputs: x_0 corresponds to CSV x1, ..., x_7 to CSV x8.
input angle[64] x_0;
input angle[64] x_1;
input angle[64] x_2;
input angle[64] x_3;
input angle[64] x_4;
input angle[64] x_5;
input angle[64] x_6;
input angle[64] x_7;

// Trained parameters supplied through weights.json.
input angle[64] theta_0;
input angle[64] theta_1;
input angle[64] theta_2;
input angle[64] theta_3;
input angle[64] theta_4;
input angle[64] theta_5;
input angle[64] theta_6;
input angle[64] theta_7;
input angle[64] theta_8;
input angle[64] theta_9;
input angle[64] theta_10;
input angle[64] theta_11;
input angle[64] theta_12;
input angle[64] theta_13;
input angle[64] theta_14;
input angle[64] theta_15;
input angle[64] theta_16;

bit[1] c;
qubit[8] q;

// Each raw CSV feature is used directly with no preprocessing: CSV x1..x8 correspond to symbolic x_0..x_7, and each x_i is inserted directly as an RY rotation angle once at the start of the circuit. Mapping: x_0->q0, x_1->q1, x_2->q2, x_3->q3, x_4->q4, x_5->q5, x_6->q6, x_7->q7.
ry(x_0) q[0];
ry(x_1) q[1];
ry(x_2) q[2];
ry(x_3) q[3];
ry(x_4) q[4];
ry(x_5) q[5];
ry(x_6) q[6];
ry(x_7) q[7];
ry(theta_0) q[0];
rz(theta_1) q[0];
ry(theta_2) q[1];
rz(theta_3) q[1];
cx q[1], q[0];
ry(theta_4) q[0];
cx q[1], q[0];
ry(theta_0) q[2];
rz(theta_1) q[2];
ry(theta_2) q[3];
rz(theta_3) q[3];
cx q[3], q[2];
ry(theta_4) q[2];
cx q[3], q[2];
ry(theta_0) q[4];
rz(theta_1) q[4];
ry(theta_2) q[5];
rz(theta_3) q[5];
cx q[5], q[4];
ry(theta_4) q[4];
cx q[5], q[4];
ry(theta_0) q[6];
rz(theta_1) q[6];
ry(theta_2) q[7];
rz(theta_3) q[7];
cx q[7], q[6];
ry(theta_4) q[6];
cx q[7], q[6];
ry(theta_5) q[0];
rz(theta_6) q[0];
ry(theta_7) q[2];
rz(theta_8) q[2];
cx q[2], q[0];
ry(theta_9) q[0];
cx q[2], q[0];
ry(theta_5) q[4];
rz(theta_6) q[4];
ry(theta_7) q[6];
rz(theta_8) q[6];
cx q[6], q[4];
ry(theta_9) q[4];
cx q[6], q[4];
ry(theta_10) q[0];
rz(theta_11) q[0];
ry(theta_12) q[4];
rz(theta_13) q[4];
cx q[4], q[0];
ry(theta_14) q[0];
cx q[4], q[0];
rz(theta_15) q[0];
ry(theta_16) q[0];
c[0] = measure q[0];
