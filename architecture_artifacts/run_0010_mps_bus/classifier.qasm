OPENQASM 3.0;
include "stdgates.inc";

// Raw feature inputs: x_0 corresponds to CSV x1, ..., x_7 to CSV x8.
input angle[64] x_0;
input angle[64] x_1;
input angle[64] x_2;
input angle[64] x_3;
input angle[64] x_4;
input angle[64] x_5;
input angle[64] x_6;
input angle[64] x_7;

// Trained parameters supplied through weights.json.
input angle[64] theta_0;
input angle[64] theta_1;
input angle[64] theta_2;
input angle[64] theta_3;
input angle[64] theta_4;
input angle[64] theta_5;
input angle[64] theta_6;
input angle[64] theta_7;
input angle[64] theta_8;
input angle[64] theta_9;
input angle[64] theta_10;
input angle[64] theta_11;
input angle[64] theta_12;
input angle[64] theta_13;
input angle[64] theta_14;
input angle[64] theta_15;
input angle[64] theta_16;
input angle[64] theta_17;
input angle[64] theta_18;
input angle[64] theta_19;
input angle[64] theta_20;
input angle[64] theta_21;
input angle[64] theta_22;
input angle[64] theta_23;
input angle[64] theta_24;
input angle[64] theta_25;
input angle[64] theta_26;
input angle[64] theta_27;
input angle[64] theta_28;
input angle[64] theta_29;

bit[1] c;
qubit[8] q;

// Each raw CSV feature is used directly with no preprocessing: CSV x1..x8 correspond to symbolic x_0..x_7, and each x_i is inserted directly as an RY rotation angle once at the start of the circuit. Mapping: x_0->q0, x_1->q1, x_2->q2, x_3->q3, x_4->q4, x_5->q5, x_6->q6, x_7->q7.
ry(x_0) q[0];
ry(x_1) q[1];
ry(x_2) q[2];
ry(x_3) q[3];
ry(x_4) q[4];
ry(x_5) q[5];
ry(x_6) q[6];
ry(x_7) q[7];
ry(theta_0) q[1];
ry(theta_1) q[0];
cx q[1], q[0];
rz(theta_2) q[0];
cx q[1], q[0];
ry(theta_3) q[0];
ry(theta_4) q[2];
ry(theta_5) q[0];
cx q[2], q[0];
rz(theta_6) q[0];
cx q[2], q[0];
ry(theta_7) q[0];
ry(theta_8) q[3];
ry(theta_9) q[0];
cx q[3], q[0];
rz(theta_10) q[0];
cx q[3], q[0];
ry(theta_11) q[0];
ry(theta_12) q[4];
ry(theta_13) q[0];
cx q[4], q[0];
rz(theta_14) q[0];
cx q[4], q[0];
ry(theta_15) q[0];
ry(theta_16) q[5];
ry(theta_17) q[0];
cx q[5], q[0];
rz(theta_18) q[0];
cx q[5], q[0];
ry(theta_19) q[0];
ry(theta_20) q[6];
ry(theta_21) q[0];
cx q[6], q[0];
rz(theta_22) q[0];
cx q[6], q[0];
ry(theta_23) q[0];
ry(theta_24) q[7];
ry(theta_25) q[0];
cx q[7], q[0];
rz(theta_26) q[0];
cx q[7], q[0];
ry(theta_27) q[0];
rz(theta_28) q[0];
ry(theta_29) q[0];
c[0] = measure q[0];
